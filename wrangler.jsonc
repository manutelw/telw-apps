{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telw-apps",
  "main": "worker-host-router.js",
  "compatibility_date": "2026-09-08",
  "vars": {
    "TELW_FROM_EMAIL": "TELW IELTS <ielts@mail.clarionprep.com>"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "PAY_DB",
      "database_name": "telw-ielts-payments",
      "database_id": "aed6ea0b-c25b-486b-a125-03e75cc6577e"
    }
  ],
  "services": [
    {
      "binding": "IELTS_ADMIN_SERVICE",
      "service": "telw-ielts-preview-worker"
    },
    {
      "binding": "PERF_SERVICE",
      "service": "telw-performance"
    }
  ]
}
