{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telw-apps",
  "main": "worker-host-router.js",
  "compatibility_date": "2026-09-08",
  "vars": {
    "TELW_FROM_EMAIL": "TELW IELTS <ielts@mail.clarionprep.com>"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "IELTS_ADMIN_SERVICE",
      "service": "telw-ielts-preview-worker"
    }
  ]
}
