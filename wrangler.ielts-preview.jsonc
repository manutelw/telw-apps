{
  "name": "telw-ielts-preview-worker",
  "main": "workers/ielts/preview.mjs",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "vars": {
    "TELW_FROM_EMAIL": "TELW IELTS <ielts@mail.clarionprep.com>"
  },
  "assets": {
    "directory": "./ielts-preview-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "IELTS_DB",
      "database_name": "telw-ielts-preview",
      "database_id": "b84edf66-8deb-471a-85e1-a8f8e138026a"
    }
  ]
}
